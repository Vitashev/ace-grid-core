{
  "name": "@ace-grid/core",
  "version": "1.0.20",
  "description": "Fast, MIT-licensed React data grid for editable, virtualized product workflows with sorting, filtering, pagination, theming, selection, and CSV I/O.",
  "type": "module",
  "module": "./dist/core.js",
  "types": "./dist/core.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "node --test tests/*.test.mjs",
    "test:types": "tsc --noEmit --strict --skipLibCheck false --target ES2020 --module ESNext --moduleResolution bundler --jsx react-jsx tests/declarations.ts",
    "test:consumer": "node tests/packed-consumer.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "react": ">=18.2.0 <20.0.0",
    "react-dom": ">=18.2.0 <20.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vitashev/ace-grid-core.git"
  },
  "bugs": {
    "url": "https://github.com/Vitashev/ace-grid-core/issues"
  },
  "homepage": "https://ace-grid.com/docs",
  "keywords": [
    "ace-grid",
    "react",
    "react-data-grid",
    "react-table",
    "data-grid",
    "javascript-data-grid",
    "editable-grid",
    "virtualized-grid",
    "datatable",
    "grid-component",
    "spreadsheet",
    "table",
    "typescript"
  ],
  "main": "./dist/core.cjs",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/react": "18.3.26",
    "@types/react-dom": "18.3.7",
    "jsdom": "26.1.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
